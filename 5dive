          # still the one reported (DIVE-4282); this is the roster behind the count.
          _sc_bad="${_sc_bad:+$_sc_bad,}$_slug2"
          if [[ -z "$_sc_err" ]]; then
            _sc_err_slug="$_slug2"
            _sc_err="$(head -c 400 "$_sc_errf" 2>/dev/null | tr '\n' ' ' || printf '')"
