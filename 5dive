  [[ "$plugin" == "telegram" ]] \
    || fail "$E_VALIDATION" "grok channel plugin unsupported: $plugin (telegram only)"
  [[ -n "$token" ]] || fail "$E_VALIDATION" "grok telegram channel requires a bot token"
