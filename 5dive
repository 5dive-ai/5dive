  # published by the root `account usage` read) so a seat whose auth account is
  # at its rate-limit wall cannot be reported `ready`.
  QUOTA_SNAPSHOT_FILE="$QUOTA_SNAPSHOT_FILE" \
  QUOTA_WALL_PCT="$QUOTA_WALL_PCT" \
