  local c
  for c in "${TELEGRAM_OPENCODE_PLUGIN_DIR:-}" \
           /usr/local/lib/5dive/telegram-opencode \
           /home/claude/projects/5dive/5dive-plugins/plugins/telegram-opencode; do
